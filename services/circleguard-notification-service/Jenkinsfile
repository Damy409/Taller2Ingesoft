pipeline {
    agent any

    environment {
        SERVICE_NAME = 'circleguard-notification-service'
        SERVICE_PATH = 'services/circleguard-notification-service'
        GRADLE_PROJECT = ':services:circleguard-notification-service'
        REGISTRY = credentials('docker-registry-url')
        IMAGE_TAG = "${BUILD_NUMBER}"
        STAGE_NAMESPACE = 'circleguard-stage'
        PROD_NAMESPACE = 'circleguard-master'
        STAGE_BASE_URL = 'http://circleguard-gateway-service.circleguard-stage.svc.cluster.local:8087'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Compile and Package') {
            steps { sh './gradlew ${GRADLE_PROJECT}:clean ${GRADLE_PROJECT}:assemble' }
        }

        stage('Unit Tests') {
            steps { sh './gradlew ${GRADLE_PROJECT}:test --tests "*ServiceTest" --tests "*ControllerTest" --tests "*RepositoryTest" --tests "*ConverterTest" || ./gradlew ${GRADLE_PROJECT}:test' }
            post { always { junit allowEmptyResults: true, testResults: "${SERVICE_PATH}/build/test-results/test/*.xml" } }
        }

        stage('Integration Tests') {
            steps { sh './gradlew ${GRADLE_PROJECT}:test --tests "*IntegrationTest" || echo "No integration test class found"' }
            post { always { junit allowEmptyResults: true, testResults: "${SERVICE_PATH}/build/test-results/test/*.xml" } }
        }

        stage('E2E Tests') {
            steps { sh './gradlew ${GRADLE_PROJECT}:test --tests "*E2ETest" || echo "No E2E test class found"' }
            post { always { junit allowEmptyResults: true, testResults: "${SERVICE_PATH}/build/test-results/test/*.xml" } }
        }

        stage('Quality Gate - Full Service Test') {
            steps { sh './gradlew ${GRADLE_PROJECT}:test' }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: "${SERVICE_PATH}/build/reports/tests/test/**" } }
        }

        stage('Static Analysis - SonarQube') {
            steps {
                sh '''
                    if command -v sonar-scanner >/dev/null 2>&1; then
                      sonar-scanner -Dsonar.projectKey=$SERVICE_NAME -Dsonar.sources=$SERVICE_PATH/src/main/java -Dsonar.tests=$SERVICE_PATH/src/test/java -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_TOKEN
                    else
                      echo "sonar-scanner not installed; configure Jenkins tool or SonarQube plugin."
                    fi
                '''
            }
        }

        stage('Docker Build and Push') {
            steps {
                sh '''
                    docker build -t "$REGISTRY/$SERVICE_NAME:$IMAGE_TAG" "$SERVICE_PATH"
                    docker push "$REGISTRY/$SERVICE_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Container Vulnerability Scan - Trivy') {
            steps {
                sh '''
                    if command -v trivy >/dev/null 2>&1; then
                      trivy image --severity HIGH,CRITICAL --exit-code 0 "$REGISTRY/$SERVICE_NAME:$IMAGE_TAG"
                    else
                      echo "trivy not installed; configure Trivy CLI/plugin in Jenkins."
                    fi
                '''
            }
        }

        stage('Deploy Stage Kubernetes') {
            when { not { anyOf { branch 'master'; branch 'main' } } }
            steps {
                sh '''
                    kubectl create namespace $STAGE_NAMESPACE --dry-run=client -o yaml | kubectl apply -f -
                    kubectl -n $STAGE_NAMESPACE set image -f $SERVICE_PATH/k8s/deployment.yaml $SERVICE_NAME=$REGISTRY/$SERVICE_NAME:$IMAGE_TAG --local -o yaml | kubectl -n $STAGE_NAMESPACE apply -f -
                    kubectl -n $STAGE_NAMESPACE apply -f $SERVICE_PATH/k8s/service.yaml
                    kubectl -n $STAGE_NAMESPACE rollout status deployment/$SERVICE_NAME --timeout=180s
                '''
            }
        }

        stage('System Validation Stage') {
            when { not { anyOf { branch 'master'; branch 'main' } } }
            steps { sh 'kubectl -n $STAGE_NAMESPACE get pods -l app=$SERVICE_NAME && kubectl -n $STAGE_NAMESPACE get service $SERVICE_NAME' }
        }

        stage('Security Test - OWASP ZAP Baseline') {
            when { not { anyOf { branch 'master'; branch 'main' } } }
            steps { sh 'docker run --rm -t owasp/zap2docker-stable zap-baseline.py -t "$STAGE_BASE_URL" -r zap-report.html || true' }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'zap-report.html' } }
        }

        stage('Locust Performance Smoke') {
            when { expression { fileExists('tests/locust_tests.py') } }
            steps { sh 'python -m pip install -q locust && mkdir -p build/locust && python -m locust -f tests/locust_tests.py --headless --host="$STAGE_BASE_URL" -u 10 -r 2 -t 1m --csv=build/locust/$SERVICE_NAME || true' }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'build/locust/**' } }
        }

        stage('Semantic Version') {
            when { anyOf { branch 'master'; branch 'main' } }
            steps { sh 'mkdir -p build && (git describe --tags --abbrev=0 2>/dev/null || echo v1.0.$BUILD_NUMBER) > build/semantic-version.txt' }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'build/semantic-version.txt' } }
        }

        stage('Generate Release Notes') {
            when { anyOf { branch 'master'; branch 'main' } }
            steps {
                sh '''
                    mkdir -p build/release-notes
                    LAST_TAG=$(git describe --tags --abbrev=0 2>/dev/null || true)
                    if [ -n "$LAST_TAG" ]; then RANGE="$LAST_TAG..HEAD"; else RANGE="HEAD~20..HEAD"; fi
                    NOTES="build/release-notes/$SERVICE_NAME-$IMAGE_TAG.md"
                    {
                      echo "# Release Notes - $SERVICE_NAME $IMAGE_TAG"
                      echo "## Change Summary"
                      git log --pretty=format:'- %h %s (%an)' $RANGE -- $SERVICE_PATH || true
                      echo "## Validation Evidence"
                      echo "- Unit, integration, E2E, SonarQube, Trivy, ZAP and Locust stages executed."
                      echo "## Rollback"
                      echo "kubectl rollout undo deployment/$SERVICE_NAME -n $PROD_NAMESPACE"
                    } > "$NOTES"
                '''
            }
            post { always { archiveArtifacts allowEmptyArchive: true, artifacts: 'build/release-notes/**' } }
        }

        stage('Production Approval') {
            when { anyOf { branch 'master'; branch 'main' } }
            steps { input message: 'Approve master deployment?', ok: 'Deploy' }
        }

        stage('Deploy Master Kubernetes') {
            when { anyOf { branch 'master'; branch 'main' } }
            steps {
                sh '''
                    kubectl create namespace $PROD_NAMESPACE --dry-run=client -o yaml | kubectl apply -f -
                    kubectl -n $PROD_NAMESPACE set image -f $SERVICE_PATH/k8s/deployment.yaml $SERVICE_NAME=$REGISTRY/$SERVICE_NAME:$IMAGE_TAG --local -o yaml | kubectl -n $PROD_NAMESPACE apply -f -
                    kubectl -n $PROD_NAMESPACE apply -f $SERVICE_PATH/k8s/service.yaml
                    kubectl -n $PROD_NAMESPACE rollout status deployment/$SERVICE_NAME --timeout=180s
                '''
            }
        }
    }

    post {
        always { archiveArtifacts allowEmptyArchive: true, artifacts: "${SERVICE_PATH}/build/libs/*.jar" }
        failure { echo 'Pipeline failed. Configure email/slack notification plugin for automatic alerts.' }
    }
}

